# Copy to .env.local for development. Never commit real values.

# The app connects as emr_app, which cannot edit or delete audit entries or hard-delete patients.
# `npm run db:app-role` gives emr_app this password; change both together.
DATABASE_URL="postgresql://emr_app:emr_app_dev_password@127.0.0.1:5432/emr"

# Owner role: used only by migrations, seed and admin scripts. Never by the running app.
DATABASE_OWNER_URL="postgresql://emr_owner:emr_dev_password@127.0.0.1:5432/emr"

# Comma-separated email domains doctors may register with. Placeholder until the real HFSO domain is confirmed.
ALLOWED_EMAIL_DOMAINS="example.org"

# Unique per install; records created here are tagged with it for fallback sync.
NODE_ID="dev-local"
