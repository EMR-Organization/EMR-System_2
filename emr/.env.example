# Copy to .env.local for development. Never commit real values.

# Owner role: used by migrations and scripts (Phase 1 adds the restricted emr_app role for the app itself)
DATABASE_URL="postgresql://emr_owner:emr_dev_password@127.0.0.1:5432/emr"

# Comma-separated email domains doctors may register with. Placeholder until the real HFSO domain is confirmed.
ALLOWED_EMAIL_DOMAINS="example.org"

# Unique per install; records created here are tagged with it for fallback sync.
NODE_ID="dev-local"
