# Copy to .env.local for development. Never commit real values.

# The app connects as emr_app, which cannot edit or delete audit entries or hard-delete patients.
# `npm run db:app-role` gives emr_app this password; change both together.
DATABASE_URL="postgresql://emr_app:emr_app_dev_password@127.0.0.1:5432/emr"

# Owner role: used only by migrations, seed and admin scripts. Never by the running app.
DATABASE_OWNER_URL="postgresql://emr_owner:emr_dev_password@127.0.0.1:5432/emr"

# Signs session cookies and keys reset codes. 32+ random characters; the field setup generates one.
# Generate your own with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="dev-only-secret-not-for-real-use-0123456789"

# Keys the audit-log hash chain. Keep it separate from BETTER_AUTH_SECRET, and never change it
# on a live install (old entries would stop verifying). The field setup generates one.
AUDIT_KEY="dev-only-audit-key-not-for-real-use-0123456789"

# "1" only when the app sits behind Caddy and listens on 127.0.0.1 (the field setup).
# Then X-Forwarded-For is trusted as the client IP; otherwise it's ignored.
TRUST_PROXY="0"

# Comma-separated email domains doctors may register with. Placeholder until the real HFSO domain is confirmed.
ALLOWED_EMAIL_DOMAINS="example.org"

# Where uploaded photos are stored (re-encoded JPEGs). Keep it on the encrypted (BitLocker) drive.
PHOTOS_DIR="data/photos"

# Unique per install; records created here are tagged with it for fallback sync.
NODE_ID="dev-local"
